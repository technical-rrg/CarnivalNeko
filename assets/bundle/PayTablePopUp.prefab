  {
    "__type__": "cc.RichText",
    "_name": "",
    "_objFlags": 0,
    "__editorExtras__": {},
    "node": {
      "__id__": 383
    },
    "_enabled": true,
    "__prefab": {
      "__id__": 387
    },
    "_lineHeight": 50,
    "_string": "\nEach Trail Symbol that lands during the base game will fly into corresponding colored fortune pouch.\nAny Trail Symbol may trigger the corresponding fortune pouch.\nMore than one fortune pouch can be triggered on a single spin.\nIf fortune pouch(s) are triggered, the corresponding feature will start.\n\n\n\n\n\n\nThe Accumulation of Trail Symbols over time in the BLUE, RED and GREEN fortune pouches have no\neffect on triggering the JACKPOT FEATURE or MATSURI FEATURE.",
    "_horizontalAlign": 1,
    "_verticalAlign": 0,
    "_fontSize": 30,
    "_fontColor": {
      "__type__": "cc.Color",
      "r": 255,
      "g": 255,
      "b": 255,
      "a": 255
    },
    "_maxWidth": 1700,
