  {
    "__type__": "cc.RichText",
    "_name": "",
    "_objFlags": 0,
    "__editorExtras__": {},
    "node": {
      "__id__": 597
    },
    "_enabled": true,
    "__prefab": {
      "__id__": 601
    },
    "_lineHeight": 35,
    "_string": "If Mighty Matsuri, Mega Matsuri, Super Matsuri, Ultra Matsuri, Supreme Matsuri, or Ultimate Matsuri is\ntriggered, then the Matsuri Feature is triggered. If the Matsuri Feature was triggered from the Mighty Matsuri or the\nUltra Matsuri, the grid will be 5x3 and 3 spins are awarded. Additionally, 6 Yellow Sticky Symbols will be placed on random\npositions at the start of the feature.\n\nIf the Matsuri Feature was triggered from the Mega Matsuri or the Supreme Matsuri, the grid will be 5x4 and 3\nspins are awarded. Additionally, 8 Yellow Symbols will be placed on random positions at the start of the feature.\n\nIf the Matsuri Feature was triggered from the Super Matsuri or the Ultimate Matsuri, the grid will be 5x5 and 3\nspins are awarded. Additionally, 10 Yellow Symbols will be placed on random positions at the start of the feature.\n\n<img src=\"45\" width=80 height=80 offset=-20/> and <img src=\"44\" width=80 height=80 offset=-20/> only appears during the Matsuri Feature.",
    "_horizontalAlign": 1,
    "_verticalAlign": 1,
    "_fontSize": 26,
    "_fontColor": {
      "__type__": "cc.Color",
