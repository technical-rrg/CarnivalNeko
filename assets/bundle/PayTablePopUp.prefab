    "_enabled": true,
    "__prefab": {
      "__id__": 773
    },
    "_lineHeight": 50,
    "_string": "All win amounts are multiplied by the base bet.\nAll values are displayed as actual coin wins.\nWhen winning with multiple symbols simultaneously, all win amounts are added together and paid as the total win.\nOnly highest win paid per winning combination.\nIn accordance with fair gaming practices, the outcome of each and every game is completely independent.\nThe chances of getting a particular outcome are always the same at the start of every game.",
    "_horizontalAlign": 1,
    "_verticalAlign": 1,
    "_fontSize": 30,
