    "_enabled": true,
    "__prefab": {
      "__id__": 427
    },
    "_lineHeight": 50,
    "_string": "Regardless of the number of <img src = '13' height=50 offset=20/>  collected from the reel result, the Feature Game may be triggered at random. \nIf a lucky event occurs, some symbols appearing on the reels will transform into\n  <img src = '13' height=50 offset=20/>  until the minimum requirement of 6 Shou Symbols for Feature entry is met.\nThe transformed <img src = '13' height=50 offset=20/>  will be assigned a Credit Value based on a random chance, after which the Feature Select screen will be displayed.\nThis lucky event may occur even if no <img src = '13' height=50 offset=20/>  appears in the reel result, and the outcome is determined independently on every spin.",
    "_horizontalAlign": 1,
    "_verticalAlign": 0,
    "_fontSize": 24,
    "_fontColor": {
      "__type__": "cc.Color",
