    "_enabled": true,
    "__prefab": {
      "__id__": 649
    },
    "_lineHeight": 65,
    "_string": "The Jackpot Bonus may be triggered if 1 or more     <img src = '11' height=50 offset=10/>    land on screen during the base game.\nA pick field is displayed with 12     <img src = '16' height=50 offset=10/>   . Picks will reveal one of the available prizes.\nAvailable prizes include the Mini Jackpot, Minor Jackpot, Major Jackpot, and Grand Jackpot.\nPicks are made until 3 matching symbols are revealed, and the value displayed in the corresponding meter is awarded.\nThe accumulation of coins in the bowl increases the chances of triggering the Jackpot Bonus.",
    "_horizontalAlign": 1,
    "_verticalAlign": 1,
    "_fontSize": 20,
    "_fontColor": {
      "__type__": "cc.Color",
      "r": 255,
      "g": 255,
      "b": 255,
      "a": 255
