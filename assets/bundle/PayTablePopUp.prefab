  {
    "__type__": "cc.RichText",
    "_name": "",
    "_objFlags": 0,
    "__editorExtras__": {},
    "node": {
      "__id__": 577
    },
    "_enabled": true,
    "__prefab": {
      "__id__": 581
    },
    "_lineHeight": 80,
    "_string": "6 na free games ang ibinibigay.\nKung may hindi bababa sa 1   <img src = '12' height=50 offset= 15/>   na lumitaw sa screen, ang kabuuan ng lahat ng value na ipinakita sa mga triggering symbol ay ibibigay para sa bawat   <img src = '12' height=50 offset= 15/>   na nasa screen.\nBukod dito, kung available ang Top Up Bonus sa panahon ng Feature Selection, maaaring maibigay ang value na ipinapakita sa Fortune Grand Jackpot meter.\nIsang alternatibong set ng reels ang gagamitin sa panahon ng Free Games Bonus. Ang mga winning combination para sa mga reel na ito ay katulad ng sa base game maliban kung may ibang nakasaad.\nAng   <img src = '12' height=50 offset= 15/>   ay lumilitaw lamang sa reels 2–4 at nagsisilbing WILD para sa lahat ng simbolo maliban sa   <img src = '13' height=50 offset= 15/>  .\nAng “Shou Bonus” sa panahon ng Free Games Bonus ay ang pinagsama-samang gantimpala ng lahat ng \n<img src = '12' height=50 offset= 15/>   at ang kabuuan ng lahat ng value na ipinakita sa bawat   <img src = '13' height=50 offset= 15/>   sa base game.\nAng “Shou Bonus” ay hindi kasama ang anumang jackpot na napanalunan.",
    "_horizontalAlign": 1,
    "_verticalAlign": 1,
    "_fontSize": 20,
    "_fontColor": {
      "__type__": "cc.Color",
      "r": 255,
      "g": 255,
      "b": 255,
      "a": 255
    },
    "_maxWidth": 900,
    "_fontFamily": "Arial",
    "_font": {
      "__uuid__": "a07455e3-7bdb-4f73-a25e-a3caf09d91b1",
      "__expectedType__": "cc.TTFFont"
