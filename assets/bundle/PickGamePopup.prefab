    "_enabled": true,
    "__prefab": {
      "__id__": 41
    },
    "_lineHeight": 30,
    "_string": "TOUCH A COIN TO REVEAL MATSURI SYMBOL OR <img src = '86' height=60 offset=-12 />. \nMATCH 3 MATSURI SYMBOLS TO AWARD A JACKPOT OR BONUS. REVEAL 3 <img src = '86' height=60 offset=-12 />\nTO UPGRADE THE JACKPOT OR BONUS AWARDED BY ONE LEVEL EXCEPT\nTHE GRAND JACKPOT WHICH WILL BE AWARDED TWICE.",
    "_horizontalAlign": 1,
    "_verticalAlign": 1,
    "_fontSize": 16,
    "_fontColor": {
      "__type__": "cc.Color",
      "r": 255,
