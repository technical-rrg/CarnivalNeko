{
  "package_version": 2,
  "version": "1.0.0",
  "name": "spin-tuner",
  "description": "Visual tuner for Slot Machine speed mode settings (Normal / Quick / Turbo)",
  "author": "SuperNova Team",
  "main": "./main.js",
  "contributions": {
    "menu": [
      {
        "path": "i18n:menu.extension",
        "label": "⚙ Spin Tuner",
        "message": "open-panel"
      }
    ],
    "messages": {
      "open-panel": {
        "methods": ["openPanel"]
      },
      "get-settings": {
        "methods": ["getSettings"]
      },
      "save-settings": {
        "methods": ["saveSettings"]
      }
    }
  },
  "panels": {
    "default": {
      "title": "Spin Tuner",
      "main": "./panel.js",
      "type": "dockable",
      "size": {
        "min-width": 720,
        "min-height": 520,
        "width": 820,
        "height": 600
      }
    }
  },
  "editor": ">=3.4.0"
}
